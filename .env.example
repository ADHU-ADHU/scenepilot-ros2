CONFIG_DIR=./config
PLATFORM_CONFIG=platform.yaml
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
USE_SIM_TIME=false
GPU_DEVICE_ID=0
MODEL_DIR=./models
SAM_CHECKPOINT=./models/sam3.pt
WHISPER_MODEL=small.en
DATA_DIR=./data
FRONT_DEVICE=/dev/video0
REAR_DEVICE=/dev/video2
FRONT_TOPIC=/camera/front/image_raw
REAR_TOPIC=/camera/rear/image_raw
OLLAMA_IMAGE=ollama/ollama:0.40.9
ROS_IMAGE=ros:jazzy-ros-base-noble
