ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app HF_HUB_OFFLINE=1
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY docker/requirements-api.txt docker/requirements-sam.txt /tmp/
RUN pip install --no-cache-dir torch==2.10.0 torchvision==0.25.0 --index-url https://download.pytorch.org/whl/cu128 \
    && pip install --no-cache-dir -r /tmp/requirements-api.txt -r /tmp/requirements-sam.txt
# The archive is source-only, at the inspected upstream commit. No host venv or weights.
ADD vendor/sam3-source.tar.gz /opt/sam3/
RUN pip install --no-cache-dir --no-build-isolation --no-deps /opt/sam3 \
    && python -c 'from sam3.model_builder import build_sam3_image_model; from sam3.model.sam3_image_processor import Sam3Processor'
COPY src/perception_core/perception_core /app/perception_core
WORKDIR /app
ENTRYPOINT ["python", "-m", "perception_core.server"]
