ARG ROS_IMAGE=ros:jazzy-ros-base-noble
FROM ${ROS_IMAGE} AS runtime
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 ROS_DISTRO=jazzy
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3-colcon-common-extensions python3-setuptools python3-pytest \
    python3-numpy python3-opencv python3-yaml python3-venv libportaudio2 \
    ros-jazzy-cv-bridge ros-jazzy-tf2-ros ros-jazzy-tf2-geometry-msgs \
    ros-jazzy-rmw-cyclonedds-cpp ros-jazzy-rosbag2 ros-jazzy-rosbag2-storage-mcap \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /ws
COPY src /ws/src
RUN source /opt/ros/jazzy/setup.bash && \
    colcon build --executor sequential --cmake-args -DBUILD_TESTING=OFF && \
    source /ws/install/setup.bash && python3 -c 'from perception_interfaces.msg import TrackingResult; import perception_ros.coordinator'
COPY docker/ros-entrypoint.sh /ros-entrypoint.sh
COPY scripts /ws/scripts
ENV ROS_LOG_DIR=/tmp/ros-logs
ENTRYPOINT ["/ros-entrypoint.sh"]
CMD ["ros2", "launch", "perception_ros", "platform.launch.py"]

FROM runtime AS speech
RUN python3 -m venv --system-site-packages /opt/speech && \
    /opt/speech/bin/pip install --no-cache-dir faster-whisper==1.2.1 sounddevice==0.5.6
ENV PATH=/opt/speech/bin:$PATH
CMD ["python", "-m", "scene_speech.stt_node"]
